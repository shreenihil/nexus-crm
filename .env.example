# ==============================================================================
# NEXUS CRM - PRODUCTION ENVIRONMENT CONFIGURATION (.env.example)
# Sovereign, Multi-Tenant Programmable CRM
# ==============================================================================

# Node Environment
NODE_ENV=production

# Database (PostgreSQL 16 + pgvector)
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_secure_pass_2026
POSTGRES_DB=nexus_db
POSTGRES_PORT=5432
DATABASE_URL=postgres://nexus:nexus_secure_pass_2026@postgres:5432/nexus_db

# Cache & Event Broker (Redis 7)
REDIS_URL=redis://redis:6379

# Object Storage (MinIO / S3 Compatible)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=nexus_admin
S3_SECRET_KEY=nexus_secure_minio_pass
S3_BUCKET=nexus-vault

# API Service
PORT=4000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Web Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
INTERNAL_API_URL=http://api:4000

# Cryptography & Platform Sovereignty
# Master KMS Key Seed (32-byte hex for initial boot, rotatable at runtime via BYOK API)
NEXUS_MASTER_KEY_SEED=4c3f71c4c1e40ebadfbcf6e4ee71321743513b6dcb1e1be92d53c617eb012a9e
