# ==============================================================================
# NEXUS CRM - PRODUCTION ENVIRONMENT CONFIGURATION (.env.example)
# Sovereign, Multi-Tenant Programmable CRM
# All secrets must be generated using './scripts/init' or './scripts/init.ps1'
# ==============================================================================

# Node Environment
NODE_ENV=production

# Database (PostgreSQL 16+)
POSTGRES_USER=nexus
POSTGRES_PASSWORD=<generate-via-scripts-init>
POSTGRES_DB=nexus_db
POSTGRES_PORT=5432
DATABASE_URL=postgres://nexus:<generate-via-scripts-init>@postgres:5432/nexus_db

# Cache & Event Broker (Redis 7)
REDIS_URL=redis://redis:6379

# Object Storage (MinIO / S3 Compatible)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=nexus_admin
S3_SECRET_KEY=<generate-via-scripts-init>
S3_BUCKET=nexus-vault

# API Service
PORT=4000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000
COOKIE_SECRET=<generate-via-scripts-init-min-32-chars>

# Web Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
INTERNAL_API_URL=http://api:4000

# Cryptography & Platform Sovereignty
# Master KMS Key Seed (32-byte hex for initial boot, rotatable at runtime via BYOK API)
NEXUS_MASTER_KEY_SEED=<generate-via-scripts-init-64-hex-chars>
