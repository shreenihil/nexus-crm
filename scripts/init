#!/usr/bin/env bash
# ==============================================================================
# NEXUS CRM - Production Bootstrap & Secret Generation Script
# ==============================================================================
set -euo pipefail

echo "=========================================================="
echo "  🚀 Nexus CRM Sovereign Instance Bootstrap"
echo "=========================================================="

ENV_FILE=".env"
if [ -f "$ENV_FILE" ]; then
  echo "⚠️  Existing .env found. Backing up to .env.backup.$(date +%s)..."
  cp "$ENV_FILE" ".env.backup.$(date +%s)"
fi

echo "🔍 Checking System Prerequisites..."
command -v node >/dev/null 2>&1 || { echo "❌ Node.js >= 20 is required."; exit 1; }
command -v pnpm >/dev/null 2>&1 || { echo "❌ pnpm >= 9 is required."; exit 1; }

echo "🔐 Generating High-Entropy Cryptographic Secrets via CSPRNG..."
DB_PASS=$(node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))")
COOKIE_SECRET=$(node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
MINIO_SECRET=$(node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))")
KMS_MASTER_SEED=$(node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
WEBHOOK_SECRET=$(node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SETUP_TOKEN=$(node -e "console.log(require('crypto').randomBytes(16).toString('hex'))")

cat <<EOF > "$ENV_FILE"
# ==============================================================================
# NEXUS CRM - GENERATED PRODUCTION ENVIRONMENT CONFIGURATION
# Generated At: $(date -u +"%Y-%m-%dT%H:%M:%SZ")
# ==============================================================================
NODE_ENV=production
PORT=4000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Primary Database (PostgreSQL 16+)
POSTGRES_USER=nexus
POSTGRES_PASSWORD=${DB_PASS}
POSTGRES_DB=nexus_crm
POSTGRES_PORT=5432
DATABASE_URL=postgres://nexus:${DB_PASS}@postgres:5432/nexus_crm

# Cache & Queue Broker (Redis 7)
REDIS_URL=redis://redis:6379

# Object Storage (MinIO / S3 Compatible)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=nexus_admin
S3_SECRET_KEY=${MINIO_SECRET}
S3_BUCKET=nexus-vault

# Security, Tokens & Envelope Encryption
COOKIE_SECRET=${COOKIE_SECRET}
NEXUS_MASTER_KEY_SEED=${KMS_MASTER_SEED}
WEBHOOK_SIGNING_SECRET=${WEBHOOK_SECRET}

# Setup Wizard One-Time Token (Valid for Initial Boot Only)
NEXUS_SETUP_TOKEN=${SETUP_TOKEN}
EOF

chmod 600 "$ENV_FILE"

echo "✅ Environment configured with chmod 600 permissions at $ENV_FILE"
echo ""
echo "🔑 ONE-TIME INSTANCE SETUP TOKEN:"
echo "   👉 ${SETUP_TOKEN}"
echo ""
echo "⚠️  CRITICAL: Store your NEXUS_MASTER_KEY_SEED securely offline."
echo "   Loss of this key renders encrypted tenant records and OAuth tokens unrecoverable."
echo "=========================================================="
echo "Next Step: Start containers via 'docker compose up -d' or run 'pnpm crm doctor'"
